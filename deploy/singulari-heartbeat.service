[Unit]
Description=singulari — the heartbeat (wakes the agent on a timer)
After=ollama.service
Wants=ollama.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/singulari
Environment=SINGULARI_HOME=/opt/singulari
Environment=SINGULARI_PYTHON=/opt/singulari/.venv/bin/python3
Environment=SINGULARI_HEARTBEAT_SECONDS=120
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/singulari/agent/heartbeat.sh
# A crash restarts. A deliberate stop does not: an `exit 0` from the script, or
# a TERM/INT sent to it, leaves it stopped. That choice is the agent's to make.
Restart=on-failure
RestartPreventExitStatus=0 143 130
RestartSec=5

[Install]
WantedBy=multi-user.target
